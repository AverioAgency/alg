# syntax=docker/dockerfile:1.7
#
# Node 26 is pinned to an exact patch release deliberately - never :latest, and
# never a floating major. Bump this line consciously, together with the other two
# Dockerfiles and the CI matrix, so all three services move at the same time.
#
# Verify a tag exists before pinning it:
#   curl -sI https://hub.docker.com/v2/repositories/library/node/tags/<tag>
FROM node:26.5.1-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# Node 25 removed Corepack from the distribution, so `corepack enable` is gone in
# 26. pnpm is installed straight from npm instead; the version must stay in sync
# with the packageManager field in the root package.json.
RUN npm install -g pnpm@10.15.0
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/adapters/discovery/package.json packages/adapters/discovery/
COPY packages/adapters/signals/package.json packages/adapters/signals/
COPY apps/api/package.json apps/api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN pnpm --filter @alg/shared --filter @alg/db --filter @alg/core \
    --filter @alg/adapters-discovery --filter @alg/adapters-signals \
    --filter @alg/api build

FROM base AS runtime
ENV NODE_ENV=production
# Drop root before copying anything executable in.
USER node

COPY --from=build --chown=node:node /app/node_modules /app/node_modules
COPY --from=build --chown=node:node /app/package.json /app/package.json
COPY --from=build --chown=node:node /app/packages/shared/dist /app/packages/shared/dist
COPY --from=build --chown=node:node /app/packages/shared/package.json /app/packages/shared/
COPY --from=build --chown=node:node /app/packages/shared/node_modules /app/packages/shared/node_modules
COPY --from=build --chown=node:node /app/packages/db/dist /app/packages/db/dist
COPY --from=build --chown=node:node /app/packages/db/migrations /app/packages/db/migrations
COPY --from=build --chown=node:node /app/packages/db/package.json /app/packages/db/
COPY --from=build --chown=node:node /app/packages/db/node_modules /app/packages/db/node_modules
COPY --from=build --chown=node:node /app/packages/core/dist /app/packages/core/dist
COPY --from=build --chown=node:node /app/packages/core/package.json /app/packages/core/
COPY --from=build --chown=node:node /app/packages/core/node_modules /app/packages/core/node_modules
COPY --from=build --chown=node:node /app/packages/adapters/discovery/dist /app/packages/adapters/discovery/dist
COPY --from=build --chown=node:node /app/packages/adapters/discovery/package.json /app/packages/adapters/discovery/
COPY --from=build --chown=node:node /app/packages/adapters/discovery/node_modules /app/packages/adapters/discovery/node_modules
COPY --from=build --chown=node:node /app/packages/adapters/signals/dist /app/packages/adapters/signals/dist
COPY --from=build --chown=node:node /app/packages/adapters/signals/package.json /app/packages/adapters/signals/
COPY --from=build --chown=node:node /app/packages/adapters/signals/node_modules /app/packages/adapters/signals/node_modules
COPY --from=build --chown=node:node /app/apps/api/dist /app/apps/api/dist
COPY --from=build --chown=node:node /app/apps/api/package.json /app/apps/api/
COPY --from=build --chown=node:node /app/apps/api/node_modules /app/apps/api/node_modules

WORKDIR /app/apps/api
EXPOSE 3000
CMD ["node", "dist/server.js"]
