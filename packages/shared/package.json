{
  "name": "@alg/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas and types. Consumed by the backend AND the Next.js frontend - must stay free of server-only imports.",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.1.5"
  }
}
