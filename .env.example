# ALG configuration. Copy to .env and fill in.
# Every variable here is validated by packages/shared/src/env.ts at startup -
# a misconfigured deploy fails fast instead of half-working.
#
# NEVER commit a filled-in .env. Real secrets belong in the deployment
# environment, not in the repository.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Data stores -------------------------------------------------------------
# Supabase is used as a plain Postgres. No RLS, no anon key in circulation -
# the frontend never connects to the database directly.
#
DATABASE_URL=postgresql://postgres:CHANGE_ME@db-alg-nexoro.averio.agency:5432/postgres
REDIS_URL=redis://redis:6379

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://db-alg-nexoro.averio.agency
# HS256 secret this project signs user JWTs with (legacy symmetric scheme).
SUPABASE_JWT_SECRET=CHANGE_ME_min_32_characters_long_secret
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# --- File storage ------------------------------------------------------------
# Local directory, mounted as a named Docker volume into api, worker and scraper.
# Not S3, not Supabase Storage.
ALG_STORAGE_PATH=/data/alg/storage
# Soft limit. Exceeding it pauses new screenshot jobs and marks health degraded.
ALG_STORAGE_MAX_GB=50
# HMAC key for public, expiring report links (GET /v1/r/:token).
ALG_STORAGE_SIGNING_SECRET=CHANGE_ME_min_32_characters_long_secret

# --- Encryption --------------------------------------------------------------
# Master key for pgcrypto-encrypted credentials (SMTP passwords, OAuth tokens).
ENCRYPTION_MASTER_KEY=CHANGE_ME_min_32_characters_long_secret

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# --- Discovery sources -------------------------------------------------------
GOOGLE_PLACES_API_KEY=
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# --- Channels ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Scraper -----------------------------------------------------------------
SCRAPER_URL=http://scraper:4000
SCRAPER_TOKEN=CHANGE_ME

# --- Safety ------------------------------------------------------------------
# Global outbound kill switch. Keep false everywhere except production.
# Staging refuses to boot with this set to true.
ALG_SENDING_ENABLED=false
ALG_MONTHLY_BUDGET_EUR=0

# Crawler identity. Must stay contactable - the crawler also respects robots.txt.
ALG_USER_AGENT=AlgBot/1.0 (+https://averio.agency/bot)

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
PUBLIC_BASE_URL=https://alg-nexoro.averio.agency

# --- Deployment (docker compose only, not read by the app) -------------------
# The Averio server already runs a Traefik; this stack joins its network instead
# of starting a second one. Verified on averiodocker: the network is called "edge".
TRAEFIK_NETWORK=edge
# Must match the entrypoint and cert resolver names of that running Traefik.
# Read them off the running container:
#   docker inspect <traefik> --format '{{range .Config.Cmd}}{{println .}}{{end}}'
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
ALG_DOMAIN=alg-nexoro.averio.agency

# --- Local development only --------------------------------------------------
# Used by the optional `postgres` compose profile; ignored in production.
POSTGRES_PASSWORD=alg-local-dev
